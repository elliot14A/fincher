# ------------------------------------------------------------------------------
# Fincher Environment Configuration
# All application variables strictly adhere to the FINCHER_{SERVICE}_{SETTING} prefix.
# Direct ClickHouse DB credentials are kept EXCLUSIVELY inside the MCP service configuration.
# ------------------------------------------------------------------------------

# Server & Telemetry
FINCHER_SERVER_PORT=8080
FINCHER_SERVER_LOG_LEVEL=info

# SQLite Operational State
FINCHER_SQLITE_PATH=fincher.db

# ClickHouse MCP Server Connection (HTTP Transport)
# The Go backend communicates with ClickHouse strictly via this MCP endpoint.
FINCHER_MCP_URL=http://127.0.0.1:8000/mcp

# Google Gemini & ADK
FINCHER_GEMINI_API_KEY=
FINCHER_GEMINI_MODEL=gemini-2.5-flash

# Simulator
FINCHER_SIMULATOR_ENABLE=false
FINCHER_SIMULATOR_INTERVAL=5s
