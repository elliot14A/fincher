# ------------------------------------------------------------------------------
# Fincher Environment Configuration
# All application variables strictly adhere to the FINCHER_{SETTING} format.
# Direct ClickHouse DB credentials are kept EXCLUSIVELY inside the MCP service configuration.
# ------------------------------------------------------------------------------

# Server & Runtime
FINCHER_PORT=8080
FINCHER_ENV=development
FINCHER_STEP_TIMEOUT=30s

# Database Configuration (SQLite / Turso / libSQL)
FINCHER_TURSO_URL=fincher.db
FINCHER_TURSO_TOKEN=

# ClickHouse MCP Server Connection (HTTP Transport)
# The Go backend communicates with ClickHouse strictly via this MCP endpoint.
FINCHER_MCP_URL=http://127.0.0.1:8000/mcp

# Google Gemini & LLM Configuration
FINCHER_GEMINI_API_KEY=
FINCHER_FLASH_MODEL=gemini-2.5-flash
FINCHER_PRO_MODEL=gemini-2.5-pro

# Operational Policy Thresholds
FINCHER_MAX_SYNC_DRIFT_MS=120.0
FINCHER_VENDOR_DEFECT_THRESHOLD=0.30
FINCHER_IMMINENT_LAUNCH_HOURS=72.0
FINCHER_DAILY_MODEL_CAP=200
